# ==============================================================================
# VYDEORA — CONFIGURATION DES SERVICES SERVEUR
# ==============================================================================

# Port d'écoute du serveur Node.js (par défaut 3000)
PORT=3000

# ------------------------------------------------------------------------------
# 1. GÉNÉRATION DE SCRIPTS IA (Texte)
# ------------------------------------------------------------------------------
# Fournisseur IA pour la génération de scripts vidéo originaux (Recommandé)
# Obtenez une clé gratuite sur : https://aistudio.google.com/
GEMINI_API_KEY=

# Modèle Gemini souhaité (optionnel, par défaut : gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Alternative : Clé d'API OpenAI (pour GPT-4o-mini ou TTS)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 2. GÉNÉRATION DE VOIX OFF IA (Text-to-Speech)
# ------------------------------------------------------------------------------
# Clé ElevenLabs pour les voix ultra-réalistes (Recommandé pour TikTok/Reels)
# Obtenez une clé sur : https://elevenlabs.io/
ELEVENLABS_API_KEY=

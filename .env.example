# ==============================================================================
# VYDEORA — CONFIGURATION DES SERVICES SERVEUR
# ==============================================================================

# Port d'écoute du serveur Node.js (par défaut 3000)
PORT=3000

# Fournisseur IA pour la génération de scripts vidéo originaux (Recommandé)
# Obtenez une clé gratuite sur : https://aistudio.google.com/
GEMINI_API_KEY=

# Modèle Gemini souhaité (optionnel, par défaut : gemini-1.5-flash)
# Exemples : gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash

# Alternative : Clé d'API OpenAI (si vous préférez utiliser OpenAI GPT-4o-mini)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
